{
  "name": "rendercli",
  "version": "0.1.0",
  "description": "Manage Render.com services from the command line: environment variables, credentials setup and more",
  "license": "MIT",
  "type": "module",
  "bin": {
    "render-cli": "dist/cli.js",
    "rendercli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "render",
    "render.com",
    "cli",
    "env",
    "environment-variables",
    "dotenv",
    "deploy"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
